#!/bin/sh
# Conventional Commits 校验：<type>(<scope>): <subject>
msg_file="$1"
first=$(head -n 1 "$msg_file")

case "$first" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

if printf '%s' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{3,72}$'; then
  exit 0
fi

echo "提交信息不符合约定式提交：" >&2
echo "  期望：<type>(<scope>): <subject>" >&2
echo "  type：feat fix docs style refactor perf test build ci chore revert" >&2
echo "  例：feat(data): add full A0h register map" >&2
exit 1
