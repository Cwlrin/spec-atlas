# agent 工作树（各票的隔离 checkout，含各自的 dist/ 与 .tmp/）
.agents/

# generated / dependencies
dist/
dist-probe*/
# 测试与沙箱探测残留（本机 ACL 下删不掉，也不该入库）
.tmp/
node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store

# sources not committed (size + license)
specs/**/source/*.pdf
archive/legacy/*.pdf

# 译文与旧手册不入库（版权与分发限制），仅本地用于抽取
specs/**/source/*.zh.md
archive/legacy/*.html
.spec-cache/
